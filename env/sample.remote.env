# "Remote" dev mode — connects directly to the shared NAS Postgres/Redis
# instances (the same ones tesla-powerwall-automation's production deployment
# uses) instead of local throwaway docker-compose containers. Use this when
# you have LAN access to the NAS (e.g. at home); use env/sample.env (local
# docker-compose mode) instead when you don't (e.g. on the road).
#
# Copy this file to .env and fill in the real values yourself — never commit
# real credentials. The CA cert referenced by DB_SSL_CA_PATH must be copied
# into THIS project's own postgres/certs/ directory (gitignored), not
# referenced from another project's directory, to avoid cross-project coupling.

DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=postgres
DB_SCHEMA=wake_on_lan

DB_SSL=true
DB_SSL_CA_PATH=./postgres/certs/katjeshome/ca.crt

REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

ALLOWED_ORIGINS=http://localhost:5173

# HTTPS / TLS for the app itself — see env/sample.env for details.
SSL_ENABLED=false
SSL_KEY_PATH=ssl/key.pem
SSL_CERT_PATH=ssl/cert.pem

WOL_DEFAULT_BROADCAST_ADDRESS=255.255.255.255
WOL_SEND_METHOD=auto
