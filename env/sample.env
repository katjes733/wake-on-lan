# "Local" dev mode — throwaway Postgres/Redis started via `bun run docker:up`
# (see docker-compose.yml). Use this when you don't have LAN access to the
# NAS (e.g. on the road); use env/sample.remote.env instead when you do
# (e.g. at home), to develop directly against the shared NAS instances.
#
# PostgreSQL — in remote mode this is the shared NAS instance, database is
# always "postgres"; this app is isolated via its own schema (DB_SCHEMA), not
# a separate database.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=postgres
DB_SCHEMA=wake_on_lan

# PostgreSQL TLS — enforced even for local dev, using a self-signed CA
# generated by `bun run generate-certs` (see scripts/generate-certs.sh).
DB_SSL=true
DB_SSL_CA_PATH=./postgres/certs/local/ca.crt

# Redis — reuses the same Redis instance tesla-powerwall-automation already runs
# against on the NAS. Used only for rate-limit counters (no sessions in v1).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS — comma-separated list of browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173

# Default broadcast address used when a target has none configured.
WOL_DEFAULT_BROADCAST_ADDRESS=255.255.255.255

# How the magic packet is sent: "dgram" (native UDP broadcast), "wakeonlan"
# (shell out to the wakeonlan CLI), or "auto" (dgram first, falls back to
# wakeonlan on a broadcast-permission error). See scripts/spike-wol.ts.
WOL_SEND_METHOD=auto
